DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Assets physically live under /public/assets and /public/uploads
    RewriteCond %{REQUEST_URI} ^/(assets|uploads)/ [OR]
    RewriteCond %{REQUEST_URI} ^/public/
    RewriteRule ^ - [L]

    RewriteRule ^assets/(.*)$ public/assets/$1 [L]
    RewriteRule ^uploads/(.*)$ public/uploads/$1 [L]

    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    RewriteRule ^ index.php [L]
</IfModule>

<FilesMatch "\.(env|log|md)$">
    Require all denied
</FilesMatch>

Options -Indexes
